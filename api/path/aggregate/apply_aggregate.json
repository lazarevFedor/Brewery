{
  "patch": {
    "tags": ["Aggregates"],
    "summary": "Apply parameter aggregate to category",
    "operationId": "applyParameterAggregate",
    "parameters": [
      { "$ref": "../../components/parameters/category_id.json#/CategoryId" },
      { "$ref": "../../components/parameters/aggregate_id.json#/AggregateId" }
    ],
    "responses": {
      "200": {
        "description": "Aggregate applied successfully",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "params_added": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "400": { "$ref": "../../components/schemas/responses/400_bad_request.json" },
      "404": { "$ref": "../../components/schemas/responses/404_not_found.json" },
      "500": { "$ref": "../../components/schemas/responses/500_internal_server_error.json" }
    }
  }
}