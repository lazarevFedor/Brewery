{
  "patch": {
    "tags": ["Aggregates"],
    "summary": "Update parameter aggregate",
    "operationId": "updateParameterAggregate",
    "parameters": [
      { "$ref": "../../components/parameters/id.json#/Id" }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
        "schema": { "$ref": "../../components/parameters/parameter_aggregate.json#/ParameterAggregateUpdate" },
        "examples": {
          "update-name-description": {
            "summary": "Update name and description",
            "value": {
              "name": "Lager Profile v2",
              "description": "Updated standard parameters for Lager"
            }
          }
        }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Parameter aggregate updated",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/parameters/parameter_aggregate.json#/ParameterAggregate" }
            ,"examples": {
              "updated": {
                "summary": "Updated aggregate",
                "value": {
                  "id": 1,
                  "name": "Lager Profile v2",
                  "description": "Updated standard parameters for Lager",
                  "numeric_param_ids": [10],
                  "enum_param_ids": [11]
                }
              }
            }
          }
        }
      },
      "400": { "$ref": "../../components/schemas/responses/400_bad_request.json" },
      "404": { "$ref": "../../components/schemas/responses/404_not_found.json" },
      "500": { "$ref": "../../components/schemas/responses/500_internal_server_error.json" }
    }
  },
  "delete": {
    "tags": ["Aggregates"],
    "summary": "Delete parameter aggregate",
    "operationId": "deleteParameterAggregate",
    "parameters": [
      { "$ref": "../../components/parameters/id.json#/Id" }
    ],
    "responses": {
      "204": {
        "description": "Parameter aggregate deleted"
      },
      "404": { "$ref": "../../components/schemas/responses/404_not_found.json" },
      "500": { "$ref": "../../components/schemas/responses/500_internal_server_error.json" }
    }
  }
}