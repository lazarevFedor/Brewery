{
  "post": {
    "tags": ["Aggregates"],
    "summary": "Create parameter aggregate",
    "operationId": "createParameterAggregate",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": { "$ref": "../../components/schemas/param_aggregate.json#/ParameterAggregateCreate" }
        }
      }
    },
    "responses": {
      "201": {
        "description": "Parameter aggregate created",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/param_aggregate.json#/ParameterAggregate" }
          }
        }
      },
      "400": { "$ref": "../../components/schemas/responses/400_bad_request.json" },
      "409": { "$ref": "../../components/schemas/responses/409_conflict.json" },
      "500": { "$ref": "../../components/schemas/responses/500_internal_server_error.json" }
    }
  },
  "get": {
    "tags": ["Aggregates"],
    "summary": "Get all parameter aggregates",
    "operationId": "listParameterAggregates",
    "parameters": [
      {
        "name": "name",
        "in": "query",
        "required": false,
        "schema": { "type": "string" },
        "description": "Optional exact aggregate name filter"
      }
    ],
    "responses": {
      "200": {
        "description": "List of aggregates",
        "content": {
          "application/json": {
            "schema": { "type": "array", "items": { "$ref": "../../components/schemas/param_aggregate.json#/ParameterAggregate" } }
          }
        }
      },
      "500": { "$ref": "../../components/schemas/responses/500_internal_server_error.json" }
    }
  }
}


