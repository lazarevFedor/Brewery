{
  "get": {
      "tags": ["Beers"],
      "summary": "Get beer's features",
      "operationId": "listFeatures",
      "parameters": [
        { "$ref": "../../components/parameters/beer_id.json#/BeerId" }
      ],
      "responses": {
        "200": {
          "description": "Beers feats list",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": { "$ref": "../../components/schemas/beer.json#/Feature" }
              }
            }
          }
        },
        "400": { "$ref": "../../components/schemas/responses/400_bad_request.json" },
        "404": { "$ref": "../../components/schemas/responses/404_not_found.json" },
        "500": { "$ref": "../../components/schemas/responses/500_internal_server_error.json" }
      }
    },

  "post": {
    "tags": ["Beers"],
    "summary": "Create beer's feature",
    "operationId": "createFeature",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "array",
            "items": { "$ref": "../../components/schemas/beer.json#/Feature" }
          }
        }
      }
    },
    "responses": {
      "201": {
        "description": "Beer's feature created",
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": { "$ref": "../../components/schemas/beer.json#/Feature" }
            }
          }
        }
      },
      "400": { "$ref": "../../components/schemas/responses/400_bad_request.json" },
      "409": { "$ref": "../../components/schemas/responses/409_conflict.json" },
      "500": { "$ref": "../../components/schemas/responses/500_internal_server_error.json" }
    }
  },

  "delete": {
    "tags": ["Beers"],
    "summary": "Delete beer' feature",
    "operationId": "deleteFeature",
    "parameters": [
      { "$ref": "../../components/parameters/beer_id.json#/BeerId" }
    ],
    "responses": {
      "204": {
        "description": "Success deleted"
      },
      "400": { "$ref": "../../components/schemas/responses/400_bad_request.json" },
      "404": { "$ref": "../../components/schemas/responses/404_not_found.json" },
      "500": { "$ref": "../../components/schemas/responses/500_internal_server_error.json" }
    }
  }
}