{
  "get": {
      "tags": ["Beers"],
      "summary": "Get beer's features",
      "operationId": "getBeersFeats",
      "parameters": [
        { "$ref": "../../components/parameters/beer_id.json#/BeerId" }
      ],
      "responses": {
        "200": {
          "description": "Beers feats list",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": { "$ref": "../../components/schemas/beer.json#/Feature" }
              }
            }
          }
        }
      }
    },

  "post": {
    "tags": ["Beers"],
    "summary": "Create beer's feature",
    "operationId": "createBeersFeat",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "array",
            "items": { "$ref": "../../components/schemas/beer.json#/Feature" }
          }
        }
      }
    },
    "responses": {
      "201": {
        "description": "Created",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },

  "patch": {
    "tags": ["Beers"],
    "summary": "Update beer's features",
    "operationId": "updateFeats",
    "parameters": [
      { "$ref": "../../components/parameters/beer_id.json#/BeerId" }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": { "$ref": "../../components/schemas/beer.json#/BeerUpdate" }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Updated beer",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/beer.json#/Beer" }
          }
        }
      }
    }
  },

  "delete": {
    "tags": ["Beers"],
    "summary": "Delete beer",
    "operationId": "deleteBeer",
    "parameters": [
      { "$ref": "../../components/parameters/beer_id.json#/BeerId" }
    ],
    "responses": {
      "200": {
        "description": "Deleted",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" }
              }
            }
          }
        }
      },
      "404": {
        "description": "Beer or Feat Not Found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}