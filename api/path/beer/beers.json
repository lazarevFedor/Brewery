{
  "get": {
      "tags": ["Beers"],
      "summary": "Get all beers",
      "operationId": "getAllBeers",
      "parameters": [
        { "$ref": "../../components/parameters/limit_offset.json#/Offset" },
        { "$ref": "../../components/parameters/limit_offset.json#/Limit" }
      ],
      "responses": {
        "200": {
          "description": "Beers list",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": { "$ref": "../../components/schemas/beer.json#/Beer" }
              }
            }
          }
        }
      }
    },

  "post": {
    "tags": ["Beers"],
    "summary": "Create beer",
    "operationId": "createBeer",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": { "$ref": "../../components/schemas/beer.json#/BeerCreate" }
        }
      }
    },
    "responses": {
      "201": {
        "description": "Created",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}