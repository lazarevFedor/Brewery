          "schema": {
            "$ref": "../../components/schemas/enum_class.json#/EnumClassCreate"
          }
        }
      }
    },
    "responses": {
      "201": {
        "description": "Created",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },

  "get": {
    "tags": ["EnumsClass"],
