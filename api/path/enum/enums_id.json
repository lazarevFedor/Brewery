{
  "patch": {
    "tags": ["EnumsClass"],
    "summary": "Update enum",
    "operationId": "updateEnums",
    "parameters": [
      { "$ref": "../../components/parameters/id.json#/Id" }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {"$ref": "../../components/schemas/enum_class.json#/EnumClass"}
        }
      }
    },
    "responses": {
      "200": {
        "description": "Updated enum",
        "content": {
          "application/json": {
            "schema": { "$ref": "../../components/schemas/beer.json#/Beer" }
          }
        }
      }
    }
  },

  "delete": {
    "tags": ["EnumsClass"],
    "summary": "Delete enum class",
    "operationId": "deleteEnum",
    "parameters": [
      { "$ref": "../../components/parameters/id.json#/Id" }
    ],
    "responses": {
      "200": {
        "description": "Deleted",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" }
              }
            }
          } 
        }
      },
      "404": {
        "description": "Enum Not Found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}