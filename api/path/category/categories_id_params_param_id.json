{
  "patch": {
	"tags": ["CategoryParams"],
	"summary": "Update parameter",
	"operationId": "updateCategoryParameter",
	"parameters": [
	  { "$ref": "../../components/parameters/id.json#/Id" },
	  {
		"name": "param_id",
		"in": "path",
		"required": true,
		"schema": { "type": "integer" }
	  },
	  {
		"name": "type",
		"in": "query",
		"required": true,
		"schema": { "type": "string", "enum": ["numeric", "enum"] },
		"examples": {
		  "numeric": { "summary": "Numeric type", "value": "numeric" },
		  "enum": { "summary": "Enum type", "value": "enum" }
		}
	  }
	],
	"requestBody": {
	  "required": true,
	  "content": {
		"application/json": {
		  "schema": {
			"oneOf": [
			  { "$ref": "../../components/schemas/category_parameter.json#/NumericParameterUpdate" },
			  { "$ref": "../../components/schemas/category_parameter.json#/EnumParameterUpdate" }
			]
		  },
		  "examples": {
			"numeric": {
			  "summary": "Numeric parameter update example",
			  "value": { "min_val": 150, "max_val": 300, "inheritable": false }
			},
			"enum": {
			  "summary": "Enum parameter update example",
			  "value": { "enum_class_id": 2, "inheritable": false }
			}
		  }
		}
	  }
	},
	"responses": {
	  "200": {
		"description": "Parameter updated",
		"content": {
		  "application/json": {
			"schema": {
			  "oneOf": [
				{ "$ref": "../../components/schemas/category_parameter.json#/NumericParameter" },
				{ "$ref": "../../components/schemas/category_parameter.json#/EnumParameter" }
			  ]
			},
			"examples": {
			  "numeric": {
				"summary": "Numeric parameter response example",
				"value": { "id": 10, "field_name": "amount", "entity_name": "beers", "min_val": 150, "max_val": 300, "inheritable": false }
			  },
			  "enum": {
				"summary": "Enum parameter response example",
				"value": { "id": 11, "enum_class_id": 2, "inheritable": false }
			  }
			}
		  }
		}
	  },
	  "400": { "$ref": "../../components/schemas/responses/400_bad_request.json" },
	  "404": { "$ref": "../../components/schemas/responses/404_not_found.json" },
	  "422": { "description": "Validation error" },
	  "500": { "$ref": "../../components/schemas/responses/500_internal_server_error.json" }
	}
  },
  "delete": {
	"tags": ["CategoryParams"],
	"summary": "Delete parameter",
	"operationId": "deleteCategoryParameter",
	"parameters": [
	  { "$ref": "../../components/parameters/id.json#/Id" },
	  {
		"name": "param_id",
		"in": "path",
		"required": true,
		"schema": { "type": "integer" }
	  },
	  {
		"name": "type",
		"in": "query",
		"required": true,
		"schema": { "type": "string", "enum": ["numeric", "enum"] }
	  }
	],
	"responses": {
	  "204": { "description": "Parameter deleted" },
	  "400": { "$ref": "../../components/schemas/responses/400_bad_request.json" },
	  "404": { "$ref": "../../components/schemas/responses/404_not_found.json" },
	  "500": { "$ref": "../../components/schemas/responses/500_internal_server_error.json" }
	}
  }
}


