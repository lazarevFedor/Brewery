{
  "get": {
	"tags": ["CategoryParams"],
	"summary": "Get all parameters for category",
	"operationId": "listCategoryParameters",
	"parameters": [
	  {
		"$ref": "../../components/parameters/id.json#/Id"
	  }
	],
	"responses": {
	  "200": {
		"description": "Parameters list",
		"content": {
		  "application/json": {
			"schema": {
			  "type": "array",
			  "items": {
				"oneOf": [
				  {
					"$ref": "../../components/schemas/category_parameter.json#/NumericParameter"
				  },
				  {
					"$ref": "../../components/schemas/category_parameter.json#/EnumParameter"
				  }
				]
			  }
			}
		  }
		}
	  },
	  "400": {
		"$ref": "../../components/schemas/responses/400_bad_request.json"
	  },
	  "404": {
		"$ref": "../../components/schemas/responses/404_not_found.json"
	  },
	  "500": {
		"$ref": "../../components/schemas/responses/500_internal_server_error.json"
	  }
	}
  }
}

