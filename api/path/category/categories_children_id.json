{
  "get": {
    "tags": ["Categories"],
    "summary": "Get category's children",
    "operationId": "listCategoryChildren",
    "parameters": [
      { "$ref": "../../components/parameters/id.json#/Id" }
    ],
    "responses": {
      "200": {
        "description": "Children categories list",
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": { "$ref": "../../components/schemas/category.json#/Category" }
            }
          }
        }
      },
      "400": { "$ref": "../../components/schemas/responses/400_bad_request.json" },
      "404": { "$ref": "../../components/schemas/responses/404_not_found.json" },
      "500": { "$ref": "../../components/schemas/responses/500_internal_server_error.json" }
    }
  }
}
