{
	"get": {
		"tags": ["CategoryParams"],
		"summary": "Get all parameters with optional filtering by category and type",
		"operationId": "listCategoryParameters",
		"parameters": [
			{ "$ref": "../../components/parameters/category_id_filter.json#/CategoryIdFilter" },
			{ "$ref": "../../components/parameters/parameter_type.json#/ParamType" },
			{
				"name": "type",
				"in": "query",
				"required": false,
				"schema": {
					"type": "string",
					"enum": ["numeric", "enum"]
				},
				"description": "Filter parameters by type. If omitted, returns both numeric and enum parameters."
			}
		],
		"responses": {
			"200": {
				"description": "Filtered list of parameters",
				"content": {
					"application/json": {
						"schema": {
							"type": "array",
							"items": {
								"oneOf": [
									{ "$ref": "../../components/parameters/numeric_parameter.json#/NumericParameter" },
									{ "$ref": "../../components/parameters/enum_parameter.json#/EnumParameter" }

								]
							}
						}
					}
				}
			},
			"400": { "$ref": "../../components/schemas/responses/400_bad_request.json" },
			"404": { "$ref": "../../components/schemas/responses/404_not_found.json" },
			"500": { "$ref": "../../components/schemas/responses/500_internal_server_error.json" }
		}
	}
}