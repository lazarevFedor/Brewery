{
  "FeatureBase": {
      "type": "object",
      "properties": {
        "name": {"type": "string"}
      }
    },

  "Feature": {
    "allOf": [
      { "$ref": "#/FeatureBase" },
      {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "integer"}
        }
      }
    ]
  },

  "BeerBase": {
    "type": "object",
    "properties": {
      "name": { "type": "string" },
      "rating": { "type": "number" },
      "description": { "type": "string" }
    }
  },

  "Beer": {
    "allOf": [
      { "$ref": "#/BeerBase" },
      {
        "type": "object",
        "required": [
          "id", "name", "rating", "description",
          "ibu", "abv", "city", "country", "category",
          "features", "amount", "units", "type"
        ],
        "properties": {
          "id": { "type": "integer" },
          "abv": { "type": "number" },
          "ibu": { "type": "number" },
          "city": { "type": "string" },
          "country": { "type": "string" },
          "category": { "$ref": "./category.json#/CategoryBase" },
          "features": {
            "type": "array",
            "items": {"type": "string"}
          },
          "amount": {"type": "integer"},
          "units": {"type":  "string"}
        }
      }
    ]   
  },


  "BeerCreate": {
    "allOf": [
      { "$ref": "#/BeerBase" },
      {
        "type": "object",
        "required": [
          "name", "description", "ibu", "abv",
          "city", "country", "category",
          "features", "amount", "units"
        ],
        "properties": {
          "abv": { "type": "number" },
          "ibu": { "type": "number" },
          "city": { "type": "string" },
          "country": { "type": "string" },
          "category": { "$ref": "./category.json#/CategoryBase" },
          "features": {
            "type": "array",
            "items": {"type": "string"}
          },
          "amount": {"type": "integer"},
          "units": {"type":  "string"}
        },
        "example": {
          "name": "Балтика 0",
          "description": "Описание",
          "abv": 7.5,
          "ibu": 100,
          "city": "Москва",
          "country": "Россия",
          "category": {
            "name": "Светлое"
          },
          "features": [
            "Вкусное",
            "Сочное"
          ],
          "amount": 100,
          "units": "Банки"
        }
      }
    ]   
  },


  "BeerUpdate": {
    "allOf": [
      { "$ref": "#/Beer" },
      {
        "required": []
      }
    ]  
  },

  "PaginatedBeers": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/BeerBase"
        }
      },
      "offset": { "type": "integer" },
      "limit": { "type": "integer" },
      "total": { "type": "integer" },
      "total_pages": { "type": "integer" },
      "has_next": { "type": "boolean" },
      "has_prev": { "type": "boolean" }
    }
  }
}