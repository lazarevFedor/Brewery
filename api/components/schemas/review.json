{
    "ReviewBase": {
        "type": "object",
        "properties": {
            "body": { "type": "string" },
            "rating": { "type": "integer" }
        }
    },

    "Review": {
        "allOf": [
            { "$ref": "#/ReviewBase" },
            {
                "type": "object",
                "required": ["id", "body", "rating"],
                "properties": {
                    "id": { "type": "integer" }
                }
            }
        ]
    },

    "ReviewCreate": {
        "allOf": [
            { "$ref": "#/ReviewBase" },
            {
                "required": ["body", "rating"] 
            }
        ]
    }
}

