{
    "EnumValueBase": {
        "type": "object",
        "properties": {
            "value": {"type": "string"},
            "position": {"type": "integer"}
        }
    },

    "EnumValue": {
        "allOf":[
            { "$ref": "#/EnumValueBase" },
            {
                "type": "object",
                "required": ["class_id", "value", "position"],
                "properties":{
                    "class_id": {"type": "integer"}
                }
            }
        ]
    },

    "EnumValueGet": {
        "allOf": [
            { "$ref": "./enum_class.json#/EnumClassWithFilter" },
            {
                "type": "object",
                "required": ["entity_name", "field_name"],
                "properties": {
                    "type": {"type": "string"}
                }
            }
        ]
    },

    "EnumValueUpdate": {
        "allOf": [
            { "$ref": "#/EnumValueBase" }
        ]
    }
}