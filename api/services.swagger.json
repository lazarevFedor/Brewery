{
  "openapi": "3.0.3",
  "info": {
    "title": "Beer Catalog API",
    "version": "1.0.0",
    "description": "API for managing categories, beers, reviews, enums, category parameters and parameter's aggregates"
  },
  "servers": [
    { "url": "http://localhost:80/api" }
  ],
  
  "tags": [
    {
      "name": "Categories",
      "description": "Все операции, связанные с категориями товаров"
    },
    {
      "name": "Beers",
      "description": "Операции, связанные с пивной продукцией"
    },
    {
      "name": "Reviews",
      "description": "Операции связанные с отзывами на пиво"
    },
    {
      "name": "EnumsClass",
      "description": "Операции, связанные с классами перечислений "
    },
    {
      "name": "EnumsValue",
      "description": "Операции связанные с перечислениями"
    },
    {
      "name": "CategoryParams",
      "description": "Операции связанные с параметрами категорий"
    }
  ],

  "paths": {
    "/categories": { "$ref": "./path/category/categories.json" },
    "/categories/{id}": { "$ref": "./path/category/categories_id.json" },
    "/categories/parent/{id}": { "$ref": "./path/category/categories_parent_id.json" },
    "/categories/children/{id}": { "$ref": "./path/category/categories_children_id.json" },

    "/beers": { "$ref": "./path/beer/beers.json" },
    "/beers/{id}": { "$ref": "./path/beer/beers_id.json" },
    "/beers/feats/{id}": { "$ref": "./path/beer/beers_feats_id.json" },
    "/categories/beers/{category_id}": { "$ref": "./path/beer/categories_beers_category_id.json" },

    "/reviews/{beer_id}": { "$ref": "./path/review/reviews_beer_id.json" },
    "/reviews/{id}": { "$ref": "./path/review/reviews_id.json" },

    "/enums": { "$ref": "./path/enum/enums.json" },
    "/enums/{id}": { "$ref": "./path/enum/enums_id.json" },

    "/enums/value": { "$ref": "./path/enum/enums_value.json" },
    "/enums/value/{id}": { "$ref": "./path/enum/enums_value_id.json" },

    "/categories/{id}/params/numeric": { "$ref": "./path/category/categories_id_params_numeric.json" },
    "/categories/{id}/params/enum": { "$ref": "./path/category/categories_id_params_enum.json" },
    "/categories/{id}/params": { "$ref": "./path/category/categories_id_params.json" },
    "/categories/{id}/params/{param_id}": { "$ref": "./path/category/categories_id_params_param_id.json"}
  }
}
