{
  "openapi": "3.0.3",
  "info": {
    "title": "Beer Catalog API",
    "version": "1.0.0",
    "description": "API for managing categories, beers and reviews"
  },
  "servers": [
    { "url": "http://localhost:80/api" }
  ],
  
  "tags": [
    {
      "name": "Categories",
      "description": "Все операции, связанные с категориями товаров"
    },
    {
      "name": "Beers",
      "description": "Операции, связанные с пивной продукцией"
    },
    {
      "name": "Reviews",
      "description": "Операции связанные с отзывами на пиво"
    }
  ],

  "paths": {
    "/categories": { "$ref": "./path/category/categories.json" },
    "/categories/{id}": { "$ref": "./path/category/categories_{id}.json" },
    "/categories/parent/{id}": { "$ref": "./path/category/categories_parent_{id}.json" },
    "/categories/children/{id}": { "$ref": "./path/category/categories_children_{id}.json" },

    "/beers": { "$ref": "./path/beer/beers.json" },
    "/beers/{id}": { "$ref": "./path/beer/beers_{id}.json" },
    "/categories/beers/{category_id}": { "$ref": "./path/beer/categories_beers_{category_id}.json" },

    "/reviews/{beer_id}": { "$ref": "./path/review/reviews_{beer_id}.json" },
    "/reviews/{id}":{ "$ref": "./path/review/reviews_{id}.json" }
  }
}
