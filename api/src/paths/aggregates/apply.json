{
  "patch": {
    "tags": [
      "Aggregates"
    ],
    "summary": "Apply parameter aggregate to class",
    "description": "Adds the aggregate's parameters to the class, preserving existing parameters and their values. Inheritable parameters are propagated to descendant classes.",
    "operationId": "applyParameterAggregate",
    "security": [
      {
        "bearerAuth": []
      }
    ],
    "parameters": [
      {
        "$ref": "#/components/parameters/classId"
      },
      {
        "$ref": "#/components/parameters/AggregateId"
      }
    ],
    "responses": {
      "200": {
        "description": "Aggregate applied successfully",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "params_added": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Number of parameter assignments added to the target class and its descendants by this request. Each new parameter-to-class assignment counts once. Reapplying an unchanged aggregate returns zero if all assignments are already present."
                }
              }
            }
          }
        }
      },
      "400": {
        "$ref": "#/components/responses/400_bad_request"
      },
      "404": {
        "$ref": "#/components/responses/404_not_found"
      },
      "409": {
        "$ref": "#/components/responses/409_conflict"
      },
      "500": {
        "$ref": "#/components/responses/500_internal_server_error"
      }
    }
  }
}
