{
  "allOf": [
    {
      "$ref": "#/components/schemas/ProductBase"
    },
    {
      "type": "object",
      "required": [
        "id",
        "name",
        "class_id",
        "base_id",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "class": {
          "$ref": "#/components/schemas/ClassBase"
        },
        "parameters": {
          "type": "object",
          "description": "Values keyed by field_name. Parameters must be allowed for the product class. Enum values must belong to the parameter; numeric values must fit its range and NUMERIC(8, 3).",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          }
        },
        "class_id": {
          "type": "integer"
        },
        "base_id": {
          "type": "integer",
          "nullable": true,
          "description": "ID базового изделия, на основе которого создано текущее"
        },
        "amount": {
          "type": "integer"
        },
        "units": {
          "type": "string"
        },
        "is_final_product": {
          "type": "boolean",
          "default": false,
          "description": "Флаг, указывающий, является ли продукт конечным готовым изделием (true), либо сырьем/полуфабрикатом в переходном состоянии (false)",
          "example": true
        }
      },
      "example": {
        "id": 1,
        "name": "Балтика 0",
        "class": {
          "name": "Светлое"
        },
        "class_id": 1,
        "base_id": null,
        "price": 100,
        "is_purchased": false,
        "is_final_product": true,
        "amount": 100,
        "units": "L",
        "parameters": {
          "alcohol": 0.5,
          "density": 11.0
        }
      }
    }
  ]
}
