{
  "type": "object",
  "required": [
    "material_id",
    "name",
    "material_amount",
    "materials",
    "base"
  ],
  "properties": {
    "material_id": {
      "type": "integer",
      "example": 5
    },
    "name": {
      "type": "string",
      "example": "Сусло"
    },
    "material_amount": {
      "type": "number",
      "format": "double",
      "example": 12.5,
      "description": "Количество материала на одну единицу родителя"
    },
    "units": {
      "type": "string",
      "example": "L"
    },
    "materials": {
      "type": "array",
      "description": "Состав этого материала (пустой, если материал не составной)",
      "items": {
        "$ref": "#/components/schemas/MaterialTreeNode"
      },
      "default": []
    },
    "base": {
      "type": "boolean",
      "example": false,
      "description": "Флаг Base материала."
    }
  },
  "example": {
    "material_id": 5,
    "name": "Сусло",
    "material_amount": 12.5,
    "units": "L",
    "materials": [
      {
        "material_id": 7,
        "name": "Солод",
        "material_amount": 2,
        "units": "kg",
        "materials": [],
        "base": false
      }
    ],
    "base": true
  }
}
