{
  "type": "object",
  "required": [
    "product_id",
    "total_cost",
    "operations",
    "material_norms"
  ],
  "properties": {
    "product_id": {
      "type": "integer",
      "description": "ID целевого продукта",
      "example": 1
    },
    "product": {
      "$ref": "#/components/schemas/ProductShort"
    },
    "total_cost": {
      "type": "number",
      "description": "Сумма стоимости покупных материалов (is_purchased = true) по нормам расхода и стоимости труда по всем операциям на запрошенное количество изделий. Трудозатраты каждой операции умножаются на требуемое количество её выходного изделия с учётом всех путей в составе. Часовая ставка равна нижней границе числового параметра hour_salary класса профессии.",
      "example": 3410
    },
    "operations": {
      "type": "array",
      "description": "Список всех технологических операций для производства продукта",
      "items": {
        "$ref": "#/components/schemas/OperationRead"
      }
    },
    "material_norms": {
      "type": "array",
      "description": "Расход всех материалов на запрошенное количество изделий. На каждом уровне состава расход на единицу родителя умножается на требуемое количество родителя. Расход по всем вхождениям материала суммируется независимо от флага base.",
      "items": {
        "$ref": "#/components/schemas/MaterialNorm"
      }
    }
  },
  "example": {
    "product_id": 1,
    "product": {
      "id": 1,
      "name": "Балтика 0"
    },
    "total_cost": 3410.0,
    "operations": [
      {
        "id": 1,
        "name": "Затирание солода",
        "description": "Затирание дробленого солода с водой при контролируемых температурных паузах",
        "operation_class_id": 3,
        "profession_id": 1,
        "step_number": 1,
        "equipment": {
          "name": "Заторно-сусловарочный аппарат",
          "work_center": "Варочный цех"
        },
        "materials": {
          "material_id": 10,
          "product_id": 11,
          "material_amount": 50,
          "base": false
        },
        "labor_cost": 3.0,
        "parameters": {
          "duration_minutes": 120,
          "temperature_celsius": 65
        }
      },
      {
        "id": 2,
        "name": "Варка сусла с охмелением",
        "description": "Варка охмеленного сусла при температуре 100°C",
        "operation_class_id": 3,
        "profession_id": 1,
        "step_number": 2,
        "equipment": {
          "name": "Сусловарочный котел ВК-500",
          "work_center": "Варочный цех"
        },
        "materials": {
          "material_id": 11,
          "product_id": 1,
          "material_amount": 100,
          "base": false
        },
        "labor_cost": 5.5,
        "parameters": {
          "duration_minutes": 90,
          "temperature_celsius": 100
        }
      }
    ],
    "material_norms": [
      {
        "material_id": 5,
        "name": "Солод светлый ячменный",
        "total_amount": 50.0,
        "base": true
      },
      {
        "material_id": 6,
        "name": "Хмель гранулированный",
        "total_amount": 1.2,
        "base": true
      },
      {
        "material_id": 10,
        "name": "Дроблёный солод",
        "total_amount": 5000,
        "base": false
      },
      {
        "material_id": 11,
        "name": "Сусло",
        "total_amount": 100,
        "base": false
      }
    ]
  }
}
