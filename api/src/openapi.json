{
  "openapi": "3.0.3",
  "info": {
    "title": "Product Catalog API",
    "version": "1.0.0",
    "description": "API for managing classes, products, reviews, enums, class parameters and parameter's aggregates"
  },
  "servers": [
    {
      "url": "http://localhost:8080/api"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Авторизация для действий Админа"
    },
    {
      "name": "Classes",
      "description": "Все операции, связанные с классами изделий"
    },
    {
      "name": "ClassParams",
      "description": "Операции связанные с параметрами классов"
    },
    {
      "name": "Aggregates",
      "description": "Операции связанные с агрегатами параметров классов"
    },
    {
      "name": "Products",
      "description": "Операции, связанные с изделиями"
    },
    {
      "name": "Materials",
      "description": "Операции, связанные с составом изделия (материалами)"
    },
    {
      "name": "History",
      "description": "Операции, связанные с историей изменений изделий"
    },
    {
      "name": "EnumsClass",
      "description": "Операции, связанные с классами перечислений "
    },
    {
      "name": "EnumsValue",
      "description": "Операции связанные с перечислениями"
    },
    {
      "name": "Operations",
      "description": "Операции преобразования одного изделия в другое (технологические операции)"
    },
    {
      "name": "Equipment",
      "description": "Операции, связанные с оборудованием и приборами"
    }
  ],
