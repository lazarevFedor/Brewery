{
    "swagger": "2.0",
    "info": {
        "description": "API for managing categories, beers, reviews, enums, category parameters and parameter's aggregates",
        "title": "Beer Catalog API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
            "url": "http://www.swagger.io/support"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/reviews/{beer_id}": {
            "post": {
                "description": "create beer's review",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Reviews"
                ],
                "summary": "create beer's review",
                "responses": {
                    "201": {
                        "description": "Review created",
                        "schema": {
                            "$ref": "#/definitions/Brewery_internal_entities.Review"
                        }
                    },
                    "400": {
                        "description": "failed",
                        "schema": {
                            "$ref": "#/definitions/Brewery_internal_entities.Review"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "Brewery_internal_entities.Review": {
            "type": "object",
            "properties": {
                "beer_id": {
                    "type": "integer"
                },
                "body": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "rating": {
                    "type": "integer"
                }
            }
        }
    },
    "externalDocs": {
        "description": "OpenAPI",
        "url": "https://swagger.io/resources/open-api/"
    }
}